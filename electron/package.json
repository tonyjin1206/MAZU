{
  "name": "ltmp-desktop",
  "version": "1.0.0",
  "description": "LTMP (Lightweight Trade Management Platform) — 外贸ERP桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.erp.foreigntrade",
    "productName": "LTMP",
    "mac": {
      "category": "public.app-category.business",
      "icon": "icon.icns",
      "target": ["dmg", "zip"],
      "hardenedRuntime": false
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LTMP"
    },
    "linux": {
      "icon": "icon.png",
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "dmg": {
      "title": "LTMP安装器",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "!backend/**",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../backend/run_dist",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../backend/frontend_dist",
        "to": "backend/frontend_dist",
        "filter": ["**/*"]
      }
    ],
    "asar": true,
    "asarUnpack": ["backend/**"]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
