# =====================
# 外贸ERP系统 — 环境配置
# =====================
# 复制此文件为 .env 并根据需要修改
# cp .env.example .env

# JWT 密钥 (生产环境请换一个复杂随机字符串)
JWT_SECRET=erp-secret-key-change-in-production

# JWT 算法
JWT_ALGORITHM=HS256

# Token 有效期(分钟)
JWT_EXPIRE_MINUTES=1440

# 默认管理员账号
DEFAULT_ADMIN_USERNAME=admin

# 默认管理员密码 (生产环境请修改)
DEFAULT_ADMIN_PASSWORD=admin123

# 数据库目录 (相对于 backend/ 目录)
ERP_DATA_DIR=

# 调试模式
DEBUG=True

# 允许的 CORS 域名 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:8788,http://127.0.0.1:5173
